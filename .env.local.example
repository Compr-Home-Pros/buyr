# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# (or the older name) NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Python Scraper (Railway) — server-only, never expose to browser
SCRAPER_API_URL=https://your-scraper.railway.app
SCRAPER_API_SECRET=your-internal-secret

# Google Maps (address → county resolution)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# CLOZR — file sniped buyers into Buyer Prospects, and read the aged Deal Machine queue.
# Mint a buyr ingest key in CLOZR. BUYR_URL defaults to the ingest URL with /buyr.
CLOZR_INGEST_URL=https://your-project.supabase.co/functions/v1/ingest
CLOZR_INGEST_KEY=
CLOZR_BUYR_URL=
